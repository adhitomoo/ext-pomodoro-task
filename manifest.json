{
  "manifest_version": 3,
  "name": "Notion Pomodoro",
  "version": "1.0.0",
  "description": "Pomodoro timer integrated with Notion — import tasks, track sessions, and sync progress back.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "scripting",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://api.clickup.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
